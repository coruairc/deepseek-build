[141.20657, "o", "\r\n=== sandbox-run.sh (blocking guard) comparison ===\r\n"]
[154.437391, "o", "sandbox-run.sh session exited 0\r\n"]
[154.454133, "o", "sandbox-run.sh result: Sandbox probe returned `sandbox-probe`; the fetch to example.com failed with an HTTP request error.\r\n"]
[154.455403, "o", "sandbox-run.sh BLOCKED connect lines: 4\r\n"]
[154.458324, "o", "      1 sandbox-run: BLOCKED connect to 104.20.23.154\r\n      1 sandbox-run: BLOCKED connect to 172.66.147.243\r\n      1 sandbox-run: BLOCKED connect to 2606:4700:10::6814:179a\r\n      1 sandbox-run: BLOCKED connect to 2606:4700:10::ac42:93f3\r\n"]
[154.458443, "o", "\r\n"]
[154.45846, "o", "note: sandbox-run.sh formats both AF_INET and AF_INET6 destinations, so a\r\n"]
[154.458472, "o", "      refused address is named in its own family's notation and 'non-ip' only\r\n"]
[154.458484, "o", "      appears for a non-IP address family. Its allowlist is family-tagged and\r\n"]
[154.458495, "o", "      built from getaddrinfo(AF_UNSPEC), so it carries the IPv6 addresses the\r\n"]
[154.458506, "o", "      resolver returns for the provider as well as the IPv4 ones. The\r\n"]
[154.458517, "o", "      web_fetch host is not on that allowlist and is refused as expected, so\r\n"]
[154.458526, "o", "      the fetch fails while the session still completes.\r\n"]
[154.458536, "o", "\r\n=== verdict ===\r\n"]
[154.458561, "o", "PASS  EGRESS-CHECK PASS\r\n"]
