# =============================================================================
# deepseek-build local-test Docker image
# =============================================================================
# TEST-ONLY — NOT the production image.
#
# Base: debian:unstable-slim (glibc ~2.44), chosen to match a typical modern
# Linux development host so a locally-built binary runs inside the container
# without "GLIBC version not found". Because it uses an unstable base it is NOT
# suitable for production and is NOT built or published by CI.
#
# Usage:
#   docker build -f docker/Dockerfile.localtest -t deepseek-build:localtest .
#   docker run -it --rm -e DEEPSEEK_API_KEY deepseek-build:localtest --version
#   docker run -it --rm -e DEEPSEEK_API_KEY -v "$PWD":/work deepseek-build:localtest
# =============================================================================

FROM debian:unstable-slim

ENV DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        ripgrep \
        curl \
        openssh-client \
        bash \
        procps \
        libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 --shell /bin/bash app

COPY LICENSE NOTICE THIRD-PARTY-NOTICES /usr/share/doc/deepseek-build/
COPY README.txt /usr/share/doc/deepseek-build/README.txt

# Local test context must contain the binary as `deepseek-build` plus the
# license files (see the usage note above).
COPY deepseek-build /usr/local/bin/deepseek-build
RUN chmod 755 /usr/local/bin/deepseek-build

WORKDIR /work
USER app

ENTRYPOINT ["deepseek-build"]
